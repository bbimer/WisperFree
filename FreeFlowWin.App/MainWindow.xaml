<Window x:Class="FreeFlowWin.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="FreeFlow Studio" Height="700" Width="1080"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        MinHeight="620" MinWidth="940"
        AllowsTransparency="True" WindowStyle="None" Background="Transparent"
        Icon="assets/logo.png"
        MouseDown="Window_MouseDown">

    <Window.Resources>

        <!-- Custom Dark CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" Background="#0A0A0E" BorderBrush="#262636" BorderThickness="1" Margin="0,0,8,0">
                                <Path x:Name="CheckMark" Data="M 3 8 L 7 12 L 14 4" Stroke="#FFFFFF" StrokeThickness="2" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#2D2D39"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#3F3F52"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#48485E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0A0A0E"/>
            <Setter Property="Foreground" Value="#F0F0F5"/>
            <Setter Property="BorderBrush" Value="#262636"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8,10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="SelectionBrush" Value="#3D3D4E"/>
        </Style>

        <!-- Symmetrical Dark Button Style -->
        <Style x:Key="DarkGrayButton" TargetType="Button">
            <Setter Property="Background" Value="#242430"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#363648"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2F2F40"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#48485E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E1E28"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows Titlebar Button Style -->
        <Style x:Key="WinTitleBtn" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0A0AA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22222E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinCloseBtn" TargetType="Button" BasedOn="{StaticResource WinTitleBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Main monolithic window container -->
    <Border CornerRadius="12" BorderBrush="#22222C" BorderThickness="1" Background="#0B0B0E" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Windows Titlebar Row -->
                <RowDefinition Height="34"/>
                <!-- Main Body Row -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================= TOP WINDOWS TITLEBAR ================= -->
            <Grid Grid.Row="0" Background="#070709">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: App Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Image Source="assets/logo.png" Width="16" Height="16" Margin="0,0,8,0"/>
                    <TextBlock Text="FreeFlow Studio" FontSize="12" FontWeight="Bold" Foreground="#D0D0D8"/>
                </StackPanel>

                <!-- Middle: Draggable window area -->
                <Grid Grid.Column="1" Background="Transparent" MouseDown="Window_MouseDown"/>

                <!-- Right: Windows Window Controls (— ☐ ✕) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Minimize (—) -->
                    <Button Style="{StaticResource WinTitleBtn}" Click="MinimizeButton_Click" ToolTip="Minimize">
                        <TextBlock Text="—" FontSize="11" FontWeight="Bold"/>
                    </Button>

                    <!-- Maximize (☐) -->
                    <Button Style="{StaticResource WinTitleBtn}" Click="MaximizeButton_Click" ToolTip="Maximize">
                        <TextBlock Text="🗖" FontSize="11"/>
                    </Button>

                    <!-- Close (✕) -->
                    <Button Style="{StaticResource WinCloseBtn}" Click="CloseButton_Click" ToolTip="Close">
                        <TextBlock Text="✕" FontSize="12" FontWeight="Bold"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ================= MAIN BODY ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Left Sidebar Column -->
                    <ColumnDefinition Width="210"/>
                    <!-- Right Content Column -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar Background -->
                <Border Grid.Column="0" Background="#070709" BorderBrush="#181820" BorderThickness="0,0,1,0"/>

                <!-- Sidebar Navigation Menu -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0" x:Name="SidebarMenu" Background="Transparent" BorderThickness="0" 
                             SelectionChanged="SidebarMenu_SelectionChanged" Margin="10,12,10,0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Height" Value="36"/>
                                <Setter Property="Margin" Value="0,2,0,2"/>
                                <Setter Property="Padding" Value="14,0,14,0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#8E8E98"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#16161E"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#2D2D39"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBoxItem x:Name="SettingsItem" IsSelected="True">
                            <TextBlock Text="General" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        </ListBoxItem>
                        
                        <ListBoxItem x:Name="QaValidatorItem">
                            <TextBlock Text="QA Voice Validator" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        </ListBoxItem>

                        <ListBoxItem x:Name="AudioConverterItem">
                            <TextBlock Text="Audio Converter" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        </ListBoxItem>

                        <ListBoxItem x:Name="StatsItem">
                            <TextBlock Text="Statistics" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        </ListBoxItem>
                        
                        <ListBoxItem x:Name="LogsItem">
                            <TextBlock Text="Logs" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        </ListBoxItem>
                    </ListBox>

                    <!-- Service Status Badge -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,0,20,18">
                        <Ellipse Height="7" Width="7" Fill="#30D158" VerticalAlignment="Center"/>
                        <TextBlock Text="Service Active" FontSize="11" Foreground="#6E6E78" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <!-- Right Content Panel -->
                <Grid Grid.Column="1" Margin="24,18,24,18" Background="Transparent">
                    <TabControl x:Name="MainTabControl" Background="Transparent" BorderThickness="0" Padding="0">
                        <TabControl.ItemContainerStyle>
                            <Style TargetType="TabItem">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Style>
                        </TabControl.ItemContainerStyle>

                        <!-- 1. TABITEM: GENERAL SETTINGS -->
                        <TabItem>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Text="General Settings" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,16"/>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="0,0,8,0">
                                        
                                        <!-- Card 1: Audio and API -->
                                        <Border Background="#121218" CornerRadius="12" Padding="20" Margin="0,0,0,14" BorderBrush="#22222C" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="Groq API Key" FontSize="12" FontWeight="SemiBold" Foreground="#D0D0D8" Margin="0,0,0,8"/>
                                                <Grid Margin="0,0,0,16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="100"/>
                                                    </Grid.ColumnDefinitions>
                                                    <PasswordBox x:Name="ApiKeyBox" Height="38" VerticalContentAlignment="Center" Background="#0A0A0E" BorderBrush="#262636" Foreground="#FFFFFF" Padding="10,0,10,0"/>
                                                    <Button Grid.Column="2" Content="Save" Click="SaveApiKey_Click" Height="38" Style="{StaticResource DarkGrayButton}"/>
                                                </Grid>

                                                <TextBlock Text="Recording Microphone" FontSize="12" FontWeight="SemiBold" Foreground="#D0D0D8" Margin="0,0,0,8"/>
                                                <ComboBox x:Name="MicComboBox" Height="38" SelectionChanged="MicComboBox_SelectionChanged" DisplayMemberPath="Name" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Card 2: Dictation Shortcut (Symmetrical Layout) -->
                                        <Border Background="#121218" CornerRadius="12" Padding="20" Margin="0,0,0,14" BorderBrush="#22222C" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="Dictation Shortcut" FontSize="12" FontWeight="SemiBold" Foreground="#D0D0D8" Margin="0,0,0,14"/>
                                                
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <!-- Modifiers -->
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Modifiers" FontSize="11" Foreground="#6E6E78" Margin="0,0,0,8"/>
                                                        <Border Height="38" Background="#0A0A0E" BorderBrush="#262636" BorderThickness="1" CornerRadius="8" Padding="12,0,12,0">
                                                            <Grid VerticalAlignment="Center">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <CheckBox Grid.Column="0" x:Name="CtrlHotkeyCheck" Content="Ctrl" Checked="Hotkey_Changed" Unchecked="Hotkey_Changed"/>
                                                                <CheckBox Grid.Column="1" x:Name="AltHotkeyCheck" Content="Alt" Checked="Hotkey_Changed" Unchecked="Hotkey_Changed"/>
                                                                <CheckBox Grid.Column="2" x:Name="ShiftHotkeyCheck" Content="Shift" Checked="Hotkey_Changed" Unchecked="Hotkey_Changed"/>
                                                                <CheckBox Grid.Column="3" x:Name="WinHotkeyCheck" Content="Win" Checked="Hotkey_Changed" Unchecked="Hotkey_Changed"/>
                                                            </Grid>
                                                        </Border>
                                                    </StackPanel>
                                                    
                                                    <!-- Trigger Key -->
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Trigger Key" FontSize="11" Foreground="#6E6E78" Margin="0,0,0,8"/>
                                                        <ComboBox x:Name="HotkeyComboBox" Height="38" SelectionChanged="Hotkey_Changed" DisplayMemberPath="Name" HorizontalAlignment="Stretch"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Card 3: Language Settings (Symmetrical 50/50 Layout) -->
                                        <Border Background="#121218" CornerRadius="12" Padding="20" Margin="0,0,0,14" BorderBrush="#22222C" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="Language &amp; Translation" FontSize="12" FontWeight="SemiBold" Foreground="#D0D0D8" Margin="0,0,0,14"/>
                                                
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Spoken Language" FontSize="11" Foreground="#6E6E78" Margin="0,0,0,6"/>
                                                        <ComboBox x:Name="LanguageComboBox" Height="38" SelectionChanged="LanguageComboBox_SelectionChanged" DisplayMemberPath="Name" HorizontalAlignment="Stretch"/>
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Transcription Mode" FontSize="11" Foreground="#6E6E78" Margin="0,0,0,6"/>
                                                        <ComboBox x:Name="TranslationModeComboBox" Height="38" SelectionChanged="TranslationModeComboBox_SelectionChanged" DisplayMemberPath="Name" HorizontalAlignment="Stretch"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Card 4: Transcription Engine -->
                                        <Border Background="#121218" CornerRadius="12" Padding="20" Margin="0,0,0,14" BorderBrush="#22222C" BorderThickness="1">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Local Mode (Whisper.net)" FontSize="13" FontWeight="SemiBold" Foreground="#D0D0D8" VerticalAlignment="Center"/>
                                                    <ui:ToggleSwitch Grid.Column="1" x:Name="LocalAiCheckBox" Checked="LocalAiCheckBox_Changed" Unchecked="LocalAiCheckBox_Changed" VerticalAlignment="Center"/>
                                                </Grid>
                                                
                                                <StackPanel x:Name="LocalModelPanel" Margin="0,14,0,0" Visibility="Collapsed">
                                                    <TextBlock Text="Model" FontSize="12" Foreground="#6E6E78" Margin="0,0,0,6"/>
                                                    <ComboBox x:Name="ModelComboBox" Height="38" SelectionChanged="ModelComboBox_SelectionChanged" HorizontalAlignment="Stretch" Margin="0,0,0,12">
                                                        <ComboBoxItem Content="ggml-base.bin (140 MB)"/>
                                                        <ComboBoxItem Content="ggml-small.bin (460 MB)"/>
                                                        <ComboBoxItem Content="ggml-large-v3-turbo.bin (1.5 GB)"/>
                                                    </ComboBox>

                                                    <Grid Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="Live Stream Preview" FontSize="12.5" FontWeight="SemiBold" Foreground="#D0D0D8"/>
                                                            <TextBlock Text="Real-time dictation preview (OFF = background audio ignored)" FontSize="10.5" Foreground="#6E6E78" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <ui:ToggleSwitch Grid.Column="1" x:Name="LivePreviewCheckBox" Checked="LivePreviewCheckBox_Changed" Unchecked="LivePreviewCheckBox_Changed" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Card 5: Custom Dictionary -->
                                        <Border Background="#121218" CornerRadius="12" Padding="20" Margin="0,0,0,10" BorderBrush="#22222C" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="Custom Vocabulary (comma-separated)" FontSize="12" FontWeight="SemiBold" Foreground="#D0D0D8" Margin="0,0,0,8"/>
                                                <TextBox x:Name="CustomTermsBox" Height="38" VerticalContentAlignment="Center" TextChanged="CustomTermsBox_TextChanged"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>

                        <!-- 2. TABITEM: QA VOICE VALIDATOR -->
                        <TabItem>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Text="QA Voice Validator (Groq STT)" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,16"/>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- LEFT COLUMN: File & Settings -->
                                    <Grid Grid.Column="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="0,0,4,0">
                                                
                                                <!-- File Drop Card -->
                                                <Border Background="#121218" CornerRadius="12" Padding="16" Margin="0,0,0,14" BorderBrush="#22222C" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="Voiceover Audio File" FontSize="12" FontWeight="SemiBold" Foreground="#D0D0D8" Margin="0,0,0,10"/>
                                                        <Border AllowDrop="True" Drop="QaFile_Drop" Background="#0A0A0E" BorderBrush="#36364A" BorderThickness="1.5" CornerRadius="10" Padding="16" Margin="0,0,0,10">
                                                            <StackPanel HorizontalAlignment="Center">
                                                                <TextBlock Text="Drag &amp; Drop Audio" FontSize="12" Foreground="#D0D0D8" HorizontalAlignment="Center" FontWeight="Bold"/>
                                                                <TextBlock Text="MP3, WAV, M4A, FLAC" FontSize="10" Foreground="#6E6E78" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBox x:Name="QaFilePathBox" Height="34" FontSize="11" VerticalContentAlignment="Center" IsReadOnly="True" Margin="0,0,0,10"/>
                                                        <Button Content="Browse Audio File" Click="BrowseQaFile_Click" Height="36" Style="{StaticResource DarkGrayButton}" HorizontalAlignment="Stretch"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Settings Card -->
                                                <Border Background="#121218" CornerRadius="12" Padding="16" Margin="0,0,0,14" BorderBrush="#22222C" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="Whisper Language" FontSize="12" FontWeight="SemiBold" Foreground="#D0D0D8" Margin="0,0,0,8"/>
                                                        <ComboBox x:Name="QaLanguageCombo" Height="38" SelectedIndex="0" Margin="0,0,0,12" HorizontalAlignment="Stretch">
                                                            <ComboBoxItem Content="Auto-Detect"/>
                                                            <ComboBoxItem Content="English (en)"/>
                                                            <ComboBoxItem Content="Russian (ru)"/>
                                                        </ComboBox>

                                                        <TextBlock Text="Whisper Context Prompt" FontSize="12" FontWeight="SemiBold" Foreground="#D0D0D8" Margin="0,0,0,8"/>
                                                        <TextBox x:Name="QaPromptBox" Height="56" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" FontSize="11"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- ElevenLabs Voice Optimization & Cheat Sheet -->
                                                <Border Background="#121218" CornerRadius="12" Padding="14" Margin="0,0,0,14" BorderBrush="#22222C" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="ElevenLabs AI Voice Presets" FontSize="12" FontWeight="SemiBold" Foreground="#D0D0D8" Margin="0,0,0,8"/>
                                                        <TextBlock Text="💡 Formula for Tier-1 Organic Tone:" FontSize="10.5" Foreground="#8E8E98" Margin="0,0,0,8"/>
                                                        
                                                        <Border Background="#0A0A0E" CornerRadius="6" Padding="10,8,10,8" Margin="0,0,0,6" BorderBrush="#1C1C24" BorderThickness="1">
                                                            <StackPanel>
                                                                <Grid Margin="0,0,0,4">
                                                                    <TextBlock Text="Stability:" FontSize="11" Foreground="#D0D0D8"/>
                                                                    <TextBlock Text="35% – 45%" FontSize="11" FontWeight="Bold" Foreground="#30D158" HorizontalAlignment="Right"/>
                                                                </Grid>
                                                                <Grid Margin="0,0,0,4">
                                                                    <TextBlock Text="Similarity:" FontSize="11" Foreground="#D0D0D8"/>
                                                                    <TextBlock Text="75% – 85%" FontSize="11" FontWeight="Bold" Foreground="#64D2FF" HorizontalAlignment="Right"/>
                                                                </Grid>
                                                                <Grid>
                                                                    <TextBlock Text="Style Exaggeration:" FontSize="11" Foreground="#D0D0D8"/>
                                                                    <TextBlock Text="10% – 15%" FontSize="11" FontWeight="Bold" Foreground="#FF9F0A" HorizontalAlignment="Right"/>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>

                                                        <Button Content="✨ Humanize Script Pacing" Click="HumanizeScript_Click" Height="32" Style="{StaticResource DarkGrayButton}" HorizontalAlignment="Stretch" Margin="0,4,0,0" ToolTip="Inserts dashes (—), pauses (...) and organic starters for natural ElevenLabs intonation"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>

                                        <Button Grid.Row="1" Content="Run STT &amp; Naturalness QA" Click="RunQaValidation_Click" Height="40" Style="{StaticResource DarkGrayButton}" HorizontalAlignment="Stretch"/>
                                    </Grid>

                                    <!-- MIDDLE COLUMN: Target Script -->
                                    <Border Grid.Column="2" Background="#121218" CornerRadius="12" Padding="16" BorderBrush="#22222C" BorderThickness="1" VerticalAlignment="Stretch">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="Original Target Script" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                                            
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                                                <TextBlock Text="Presets:" FontSize="11" Foreground="#6E6E78" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <Button Content="Crypto (EN)" Click="PresetCrypto_Click" Height="26" Padding="10,0,10,0" Background="#1E1E28" Foreground="#D0D0D8" FontSize="10.5" Margin="0,0,6,0" BorderThickness="1" BorderBrush="#2A2A38" Cursor="Hand"/>
                                                <Button Content="Subtitles (RU)" Click="PresetSubtitles_Click" Height="26" Padding="10,0,10,0" Background="#1E1E28" Foreground="#D0D0D8" FontSize="10.5" BorderThickness="1" BorderBrush="#2A2A38" Cursor="Hand"/>
                                            </StackPanel>

                                            <TextBox Grid.Row="2" x:Name="OriginalScriptBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#0A0A0E" BorderBrush="#22222E" Foreground="#F0F0F5" Padding="12" FontSize="12" VerticalAlignment="Stretch"/>
                                        </Grid>
                                    </Border>

                                    <!-- RIGHT COLUMN: Validation & Diff Output -->
                                    <Border Grid.Column="4" Background="#121218" CornerRadius="12" Padding="16" BorderBrush="#22222C" BorderThickness="1" VerticalAlignment="Stretch">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="Groq STT, Prosody &amp; Diff Results" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12"/>

                                            <!-- Sleek Monolithic Metrics Bar (4 Columns) -->
                                            <Grid Grid.Row="1" Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <Border Grid.Column="0" Background="#0A0A0E" Padding="8,6,8,6" CornerRadius="8" Margin="0,0,2,0" BorderBrush="#1C1C24" BorderThickness="1">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="ACCURACY" FontSize="8.5" Foreground="#6E6E78" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                        <TextBlock x:Name="AccuracyText" Text="100%" FontSize="15" FontWeight="Bold" Foreground="#30D158" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Column="1" Background="#0A0A0E" Padding="8,6,8,6" CornerRadius="8" Margin="2,0,2,0" BorderBrush="#1C1C24" BorderThickness="1">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="MATCHED" FontSize="8.5" Foreground="#6E6E78" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                        <TextBlock x:Name="MatchedCountText" Text="0" FontSize="15" FontWeight="Bold" Foreground="#30D158" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Column="2" Background="#0A0A0E" Padding="8,6,8,6" CornerRadius="8" Margin="2,0,2,0" BorderBrush="#1C1C24" BorderThickness="1">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="ERRORS" FontSize="8.5" Foreground="#6E6E78" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                        <TextBlock x:Name="ErrorsCountText" Text="0" FontSize="15" FontWeight="Bold" Foreground="#FF453A" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Column="3" Background="#0A0A0E" Padding="8,6,8,6" CornerRadius="8" Margin="2,0,0,0" BorderBrush="#1C1C24" BorderThickness="1">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="NATURALNESS" FontSize="8.5" Foreground="#6E6E78" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                        <TextBlock x:Name="NaturalnessText" Text="-- %" FontSize="15" FontWeight="Bold" Foreground="#64D2FF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- Diff Output Box -->
                                            <Border Grid.Row="2" Background="#0A0A0E" CornerRadius="10" Padding="12" BorderBrush="#22222E" BorderThickness="1" VerticalAlignment="Stretch">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <StackPanel x:Name="DiffOutputPanel"/>
                                                </ScrollViewer>
                                            </Border>
                                        </Grid>
                                    </Border>

                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- 3. TABITEM: AUDIO CONVERTER -->
                        <TabItem>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Audio Converter (FFmpeg Engine)" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,16"/>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="0,0,8,0">
                                        
                                        <!-- Drag & Drop Card -->
                                        <Border Background="#121218" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="#22222C" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="Media Input File" FontSize="12" FontWeight="SemiBold" Foreground="#D0D0D8" Margin="0,0,0,10"/>
                                                <Border AllowDrop="True" Drop="ConverterFile_Drop" Background="#0A0A0E" BorderBrush="#36364A" BorderThickness="1.5" CornerRadius="12" Padding="24" Margin="0,0,0,12" Cursor="Hand" MouseDown="BrowseConverterFile_Click">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="Drop Audio or Video Files Here" FontSize="14" FontWeight="Bold" Foreground="#D0D0D8" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Supports MP3, WAV, M4A, FLAC, MP4, MOV, AVI &amp; more" FontSize="11" Foreground="#6E6E78" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBox x:Name="ConverterFilePathBox" Height="36" FontSize="11" VerticalContentAlignment="Center" IsReadOnly="True"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Symmetrical Pipeline Settings Card -->
                                        <Border Background="#121218" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="#22222C" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="Pipeline Conversion Settings" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,16"/>

                                                <Grid Margin="0,0,0,16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Format -->
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Output Format" FontSize="11" Foreground="#6E6E78" Margin="0,0,0,6"/>
                                                        <ComboBox x:Name="ConverterFormatCombo" Height="38" SelectedIndex="0" HorizontalAlignment="Stretch">
                                                            <ComboBoxItem Content="MP3 (MPEG Audio)"/>
                                                            <ComboBoxItem Content="WAV (Uncompressed PCM)"/>
                                                            <ComboBoxItem Content="M4A (AAC Audio)"/>
                                                            <ComboBoxItem Content="FLAC (Lossless)"/>
                                                            <ComboBoxItem Content="AAC"/>
                                                            <ComboBoxItem Content="OGG (Vorbis)"/>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <!-- Sample Rate -->
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Sample Rate" FontSize="11" Foreground="#6E6E78" Margin="0,0,0,6"/>
                                                        <ComboBox x:Name="ConverterSampleRateCombo" Height="38" SelectedIndex="1" HorizontalAlignment="Stretch">
                                                            <ComboBoxItem Content="Original Sample Rate"/>
                                                            <ComboBoxItem Content="44100 Hz (CD)"/>
                                                            <ComboBoxItem Content="48000 Hz (Video)"/>
                                                            <ComboBoxItem Content="96000 Hz (Hi-Res)"/>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <!-- Bitrate -->
                                                    <StackPanel Grid.Column="4">
                                                        <TextBlock Text="Bitrate" FontSize="11" Foreground="#6E6E78" Margin="0,0,0,6"/>
                                                        <ComboBox x:Name="ConverterBitrateCombo" Height="38" SelectedIndex="3" HorizontalAlignment="Stretch">
                                                            <ComboBoxItem Content="128 kbps"/>
                                                            <ComboBoxItem Content="192 kbps"/>
                                                            <ComboBoxItem Content="256 kbps"/>
                                                            <ComboBoxItem Content="320 kbps"/>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <!-- Channels -->
                                                    <StackPanel Grid.Column="6">
                                                        <TextBlock Text="Channels" FontSize="11" Foreground="#6E6E78" Margin="0,0,0,6"/>
                                                        <ComboBox x:Name="ConverterChannelsCombo" Height="38" SelectedIndex="0" HorizontalAlignment="Stretch">
                                                            <ComboBoxItem Content="Stereo (2 Channels)"/>
                                                            <ComboBoxItem Content="Mono (1 Channel)"/>
                                                            <ComboBoxItem Content="Original Channels"/>
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Grid>

                                                <CheckBox x:Name="ConverterExtractCheck" Content="Extract Audio from Video Containers" IsChecked="True" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Action Button & Progress Bar -->
                                        <Button Content="Convert Audio via FFmpeg Engine" Click="RunAudioConvert_Click" Height="40" Style="{StaticResource DarkGrayButton}" Margin="0,0,0,16"/>

                                        <ProgressBar x:Name="ConvertProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Background="#0A0A0E" Foreground="#3F3F52" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="ConvertStatusText" Text="Ready for audio conversion." FontSize="11" Foreground="#6E6E78" HorizontalAlignment="Center"/>

                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>

                        <!-- 4. TABITEM: STATISTICS -->
                        <TabItem>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Text="Statistics" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,16"/>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="0,0,8,0">
                                        <!-- Card 1: Activity (Words) -->
                                        <Border Background="#121218" CornerRadius="12" Padding="20" Margin="0,0,0,14" BorderBrush="#22222C" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="ACTIVITY (WORDS)" FontSize="11" FontWeight="Bold" Foreground="#8E8E98" Margin="0,0,0,16"/>
                                                
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Today:" Foreground="#6E6E78" FontSize="13"/>
                                                    <TextBlock Grid.Column="1" x:Name="StatsTodayText" Text="0 words" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>
                                                </Grid>
                                                <Border BorderBrush="#1C1C24" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>

                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Last 7 Days:" Foreground="#6E6E78" FontSize="13"/>
                                                    <TextBlock Grid.Column="1" x:Name="StatsWeekText" Text="0 words" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>
                                                </Grid>
                                                <Border BorderBrush="#1C1C24" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>

                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Last 30 Days:" Foreground="#6E6E78" FontSize="13"/>
                                                    <TextBlock Grid.Column="1" x:Name="StatsMonthText" Text="0 words" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>
                                                </Grid>
                                                <Border BorderBrush="#1C1C24" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="All Time:" Foreground="#6E6E78" FontSize="13"/>
                                                    <TextBlock Grid.Column="1" x:Name="StatsAllTimeText" Text="0 words" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Card 2: Productivity -->
                                        <Border Background="#121218" CornerRadius="12" Padding="20" Margin="0,0,0,10" BorderBrush="#22222C" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="PRODUCTIVITY" FontSize="11" FontWeight="Bold" Foreground="#30D158" Margin="0,0,0,16"/>

                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Input speedup compared to manual typing:" Foreground="#6E6E78" FontSize="13"/>
                                                    <TextBlock Grid.Column="1" x:Name="StatsSpeedupText" Text="3.5x faster" Foreground="#30D158" FontSize="13" FontWeight="Bold"/>
                                                </Grid>
                                                <Border BorderBrush="#1C1C24" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>

                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Time saved:" Foreground="#6E6E78" FontSize="13"/>
                                                    <TextBlock Grid.Column="1" x:Name="StatsTimeSavedText" Text="0.0 min" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>
                                                </Grid>
                                                <Border BorderBrush="#1C1C24" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>

                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Average speech rate (per minute):" Foreground="#6E6E78" FontSize="13"/>
                                                    <TextBlock Grid.Column="1" x:Name="StatsWpmText" Text="140 words/min" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>
                                                </Grid>
                                                <Border BorderBrush="#1C1C24" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>

                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Average speech rate (per second):" Foreground="#6E6E78" FontSize="13"/>
                                                    <TextBlock Grid.Column="1" x:Name="StatsWpsText" Text="2.3 words/sec" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>
                                                </Grid>
                                                <Border BorderBrush="#1C1C24" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Total recording sessions:" Foreground="#6E6E78" FontSize="13"/>
                                                    <TextBlock Grid.Column="1" x:Name="StatsSessionsText" Text="0 sessions" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>

                        <!-- 5. TABITEM: LOGS -->
                        <TabItem>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Text="Console Log" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,16"/>
                                
                                <Border Grid.Row="1" Background="#0A0A0E" CornerRadius="12" Padding="12" BorderBrush="#22222E" BorderThickness="1">
                                    <ListBox x:Name="LogListBox" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Time}" Foreground="#6E6E78" FontFamily="Consolas" FontSize="11.5" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="{Binding Color}" TextWrapping="Wrap" FontFamily="Segoe UI" FontSize="12.5" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Focusable" Value="False"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border Background="{TemplateBinding Background}" Padding="6,3,6,3">
                                                                <ContentPresenter/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
