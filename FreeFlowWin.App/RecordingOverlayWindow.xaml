<Window x:Class="FreeFlowWin.App.RecordingOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recording..." Height="80" Width="280"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False">

    <Grid>
        <!-- Black pill: animated spectrum + 'Dictating' label (macOS style, scaled for 2K) -->
        <Border Background="#FF000000" CornerRadius="24" Padding="22,10,24,10" HorizontalAlignment="Center" VerticalAlignment="Center" Height="48" BorderThickness="1" BorderBrush="#33FFFFFF">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Color="#000000" Opacity="0.6"/>
            </Border.Effect>
            
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Equalizer bars -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="28" Margin="0,0,12,0">
                    <Rectangle Width="3.5" Height="14" Fill="White" RadiusX="1.8" RadiusY="1.8" Margin="1.8,0">
                        <Rectangle.RenderTransform>
                            <ScaleTransform x:Name="Scale1" CenterY="7"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle Width="3.5" Height="20" Fill="White" RadiusX="1.8" RadiusY="1.8" Margin="1.8,0">
                        <Rectangle.RenderTransform>
                            <ScaleTransform x:Name="Scale2" CenterY="10"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle Width="3.5" Height="26" Fill="White" RadiusX="1.8" RadiusY="1.8" Margin="1.8,0">
                        <Rectangle.RenderTransform>
                            <ScaleTransform x:Name="Scale3" CenterY="13"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle Width="3.5" Height="20" Fill="White" RadiusX="1.8" RadiusY="1.8" Margin="1.8,0">
                        <Rectangle.RenderTransform>
                            <ScaleTransform x:Name="Scale4" CenterY="10"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle Width="3.5" Height="14" Fill="White" RadiusX="1.8" RadiusY="1.8" Margin="1.8,0">
                        <Rectangle.RenderTransform>
                            <ScaleTransform x:Name="Scale5" CenterY="7"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </StackPanel>

                <!-- Label -->
                <TextBlock Text="Dictating" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="17" Foreground="#FFFFFF" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
